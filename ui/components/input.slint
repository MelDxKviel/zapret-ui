import { ThemePalette } from "../tokens.slint";
import { Icon } from "icon.slint";

// Search / input field with a crisp focus border. Trailing controls can
// be injected via @children (e.g. a "clear" button).
export component AppInput inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> enabled: true;
    in property <image> icon;
    in property <length> field-height: 36px;
    in property <length> font-size: ThemePalette.fs-13;

    callback edited(string);
    callback accepted(string);

    property <bool> focused: scope.has-focus;

    height: root.field-height;
    border-radius: ThemePalette.r-8;
    border-width: 1px;
    border-color: root.focused ? ThemePalette.accent-text : ThemePalette.border-strong;
    background: ThemePalette.surface;
    opacity: root.enabled ? 1 : 0.5;
    animate border-color { duration: 120ms; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;

        if root.icon.width > 0 : Icon {
            source: root.icon;
            size: 14px;
            tint: ThemePalette.text-3;
        }

        scope := FocusScope {
            input := TextInput {
                width: 100%;
                height: 100%;
                text <=> root.text;
                font-family: ThemePalette.font-sans;
                font-size: root.font-size;
                color: ThemePalette.text;
                vertical-alignment: center;
                horizontal-alignment: left;
                single-line: true;
                enabled: root.enabled;
                edited => { root.edited(self.text); }
                accepted => { root.accepted(self.text); }
            }

            if root.text == "" : Text {
                width: 100%;
                height: 100%;
                text: root.placeholder;
                font-family: ThemePalette.font-sans;
                font-size: root.font-size;
                color: ThemePalette.text-4;
                vertical-alignment: center;
                horizontal-alignment: left;
            }
        }

        @children
    }
}
