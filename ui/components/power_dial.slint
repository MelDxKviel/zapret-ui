import { ThemePalette } from "../tokens.slint";

// A flat, legible power control. Only the short connecting/stopping states
// subscribe to animation-tick(); active and idle states are entirely static.
export component PowerDial inherits Rectangle {
    in property <string> state: "off"; // off | connecting | active | error | stopping
    in property <string> tag: "";
    in property <bool> enabled: true;
    callback clicked();

    property <bool> is-active: root.state == "active";
    property <bool> is-connecting: root.state == "connecting";
    property <bool> is-error: root.state == "error";
    property <bool> is-stopping: root.state == "stopping";
    property <color> mark-color: root.is-error ? ThemePalette.danger-text
        : (root.is-active || root.state == "off") ? ThemePalette.accent-ink
        : root.is-connecting ? ThemePalette.accent-text
        : ThemePalette.text-2;

    width: 196px;
    height: 196px;
    horizontal-stretch: 0;
    vertical-stretch: 0;

    Rectangle {
        width: 188px;
        height: 188px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: self.width / 2;
        border-width: 2px;
        border-color: root.is-error ? ThemePalette.danger-line
            : root.is-active ? ThemePalette.accent-border
            : ThemePalette.border;
        background: transparent;
        animate border-color { duration: 160ms; }
    }

    if root.is-connecting || root.is-stopping : Image {
        source: @image-url("../../assets/icons/dial-arc.svg");
        width: 188px;
        height: 188px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        colorize: root.is-stopping ? ThemePalette.text-3 : ThemePalette.accent;
        transform-rotation: root.is-stopping
            ? -(mod(animation-tick(), 1200ms) / 1200ms) * 360deg
            : (mod(animation-tick(), 1200ms) / 1200ms) * 360deg;
    }

    Rectangle {
        width: 164px;
        height: 164px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: self.width / 2;
        background: (root.is-active || root.state == "off")
            ? (cta.pressed ? ThemePalette.accent-pressed : cta.has-hover ? ThemePalette.accent-hover : ThemePalette.accent)
            : root.is-error ? ThemePalette.danger-soft
            : root.is-connecting ? ThemePalette.accent-surface
            : (cta.has-hover && root.enabled ? ThemePalette.surface-hover : ThemePalette.surface-2);
        border-width: 1px;
        border-color: (root.is-active || root.state == "off") ? ThemePalette.accent
            : root.is-error ? ThemePalette.danger-line
            : (cta.has-hover && root.enabled ? ThemePalette.border-strong : ThemePalette.border);
        animate background, border-color { duration: 140ms; }

        VerticalLayout {
            alignment: center;
            spacing: 14px;
            HorizontalLayout {
                alignment: center;
                Image {
                    source: @image-url("../../assets/icons/power.svg");
                    width: 44px;
                    height: 44px;
                    colorize: root.mark-color;
                }
            }
            Text {
                text: root.tag;
                horizontal-alignment: center;
                font-family: ThemePalette.font-mono;
                font-size: ThemePalette.fs-10;
                font-weight: 600;
                letter-spacing: 1.2px;
                color: root.mark-color;
            }
        }
    }

    cta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}
