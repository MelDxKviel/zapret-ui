import { ThemePalette } from "../tokens.slint";

// Compact switch; motion only during a user toggle.
export component AppSwitch inherits Rectangle {
    in-out property <bool> checked;
    in property <bool> enabled: true;

    callback toggled(bool);

    width: 38px;
    height: 22px;
    border-radius: ThemePalette.r-full;
    border-width: 1px;
    border-color: root.checked ? ThemePalette.accent : ThemePalette.border-strong;
    background: root.checked ? ThemePalette.accent : ThemePalette.surface-2;
    opacity: root.enabled ? 1.0 : 0.45;
    animate background { duration: 160ms; easing: ease-in-out; }

    Rectangle {
        x: root.checked ? 19px : 3px;
        y: 3px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: root.checked ? ThemePalette.accent-ink : ThemePalette.text-3;
        animate x { duration: 160ms; easing: ease-in-out; }
        animate background { duration: 160ms; easing: ease-in-out; }
    }

    TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}
