import { ThemePalette } from "../tokens.slint";
import { I18n } from "../i18n.slint";
import { AppButton } from "button.slint";
import { Segmented } from "segmented.slint";

// A single choice control; install/update tools belong to Settings.
export component EngineSelector inherits Rectangle {
    in property <string> mode;
    in property <string> active;
    in property <string> version;
    in property <bool> busy;
    in property <bool> choice_busy: root.busy;
    in property <bool> installed;
    in property <bool> management: false;
    callback selected(string);
    callback install;
    callback update;
    background: transparent;
    vertical-stretch: 0;
    VerticalLayout {
        spacing: 12px;
        HorizontalLayout {
            spacing: 12px;
            Text {
                text: I18n.t(I18n.lang, "engine.title");
                font-family: ThemePalette.font-sans;
                font-size: ThemePalette.fs-12;
                color: ThemePalette.text-2;
                vertical-alignment: center;
            }
            Segmented {
                selected: root.mode;
                enabled: !root.choice_busy;
                seg-height: 30px;
                options: [
                    { value: "zapret1", label: I18n.t(I18n.lang, "engine.zapret1") },
                    { value: "zapret2", label: I18n.t(I18n.lang, "engine.zapret2_beta") },
                ];
                changed(mode) => { root.selected(mode); }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        if root.management : HorizontalLayout {
            spacing: 16px;
            Text {
                text: root.installed ? root.version : I18n.t(I18n.lang, "sidebar.status_not_installed");
                font-family: ThemePalette.font-mono;
                font-size: ThemePalette.fs-11;
                color: ThemePalette.text-3;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            AppButton {
                text: root.installed ? I18n.t(I18n.lang, "engine.update") : I18n.t(I18n.lang, "engine.install");
                size: "sm"; enabled: !root.busy;
                clicked => { if root.installed { root.update(); } else { root.install(); } }
            }
        }
    }
}
