import { ThemePalette, TestResultItem } from "../tokens.slint";
import { I18n } from "../i18n.slint";
import { AppButton } from "../components/button.slint";
import { StarToggle } from "../components/star.slint";
import { ListView } from "std-widgets.slint";

// ── One ranked result row ──
component ResultRow inherits Rectangle {
    in property <TestResultItem> item;
    in property <bool> is_active;   // currently the user's selected strategy
    callback use_clicked();
    callback toggle_favorite();

    height: 78px;
    background: root.is_active || root.item.is_best ? ThemePalette.accent-surface
        : ta.has-hover ? ThemePalette.surface-hover : ThemePalette.surface;
    animate background { duration: 120ms; }

    Rectangle { y: parent.height - 1px; height: 1px; background: ThemePalette.divider; }

    ta := TouchArea {
        // Only a result that reached at least one endpoint is selectable —
        // mirrors the disabled "Use" button so a row click can't pick a
        // strategy the test showed as fully blocked.
        mouse-cursor: root.item.ok > 0 ? pointer : default;
        clicked => { if (root.item.ok > 0) { root.use_clicked(); } }
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;

        // rank
        VerticalLayout {
            alignment: center;
            width: 30px;
            Rectangle {
                width: 30px;
                height: 30px;
                border-radius: ThemePalette.r-8;
                background: root.item.is_best ? ThemePalette.accent : ThemePalette.surface-2;
                Text {
                    text: root.item.rank > 0 ? "\{root.item.rank}" : "·";
                    font-family: ThemePalette.font-mono;
                    font-size: ThemePalette.fs-12;
                    font-weight: 600;
                    color: root.item.is_best ? ThemePalette.accent-ink : ThemePalette.text-2;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // name + alt — fixed *preferred* width keeps the bar column aligned
        // across rows, but the cell may shrink (name and chip elide) on narrow
        // windows instead of pushing the action button out of the card.
        VerticalLayout {
            horizontal-stretch: 0;
            min-width: 120px;
            preferred-width: 190px;
            max-width: 190px;
            alignment: center;
            spacing: 5px;
            HorizontalLayout {
                spacing: 6px;
                Text {
                    horizontal-stretch: 0;
                    min-width: 40px;
                    text: root.item.pretty;
                    font-family: ThemePalette.font-mono;
                    font-size: ThemePalette.fs-13;
                    font-weight: 600;
                    color: ThemePalette.text;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if root.item.alt != "" : Rectangle {
                    horizontal-stretch: 0;
                    max-width: 110px;
                    height: 21px;
                    border-radius: ThemePalette.r-6;
                    border-width: 1px;
                    border-color: ThemePalette.border;
                    background: ThemePalette.surface;
                    HorizontalLayout {
                        padding-left: 7px;
                        padding-right: 7px;
                        Text {
                            text: root.item.alt;
                            font-family: ThemePalette.font-mono;
                            font-size: ThemePalette.fs-10;
                            color: ThemePalette.text-2;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
                // Soak up leftover width so name + chip stay hugged together.
                Rectangle { horizontal-stretch: 1; min-width: 0px; }
            }
            if root.item.is_best : Text {
                text: I18n.t(I18n.lang, "tester.best_label");
                font-family: ThemePalette.font-mono;
                font-size: ThemePalette.fs-10;
                color: ThemePalette.accent-text;
                overflow: elide;
            }
        }

        // score bar — the min fits the full stats line ("12/12 доступно ·
        // 1569 мс"); the layout drains the stretchy column to its minimum
        // before touching the others, so a smaller min would elide the stats
        // long before the name column gives up its slack.
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 150px;
            preferred-width: 240px;
            alignment: center;
            spacing: 8px;
            Rectangle {
                height: 5px;
                border-radius: ThemePalette.r-4;
                background: ThemePalette.border;
                clip: true;
                Rectangle {
                    x: 0;
                    width: parent.width * root.item.ok / max(root.item.total, 1);
                    height: parent.height;
                    border-radius: ThemePalette.r-4;
                    background: root.item.ok == 0 ? ThemePalette.danger
                        : root.item.ok >= root.item.total ? ThemePalette.accent
                        : ThemePalette.warning;
                    animate width { duration: 200ms; easing: ease-out; }
                }
            }
            Text {
                text: "\{root.item.ok}/\{root.item.total}" + I18n.t(I18n.lang, "tester.reachable")
                    + (root.item.latency > 0 ? " · \{root.item.latency}" + I18n.t(I18n.lang, "tester.ms_avg") : "");
                font-family: ThemePalette.font-mono;
                font-size: ThemePalette.fs-11;
                color: root.item.ok == 0 ? ThemePalette.danger-text : ThemePalette.text-2;
                min-width: 0px;
                overflow: elide;
            }
        }

        // favorite star
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            StarToggle {
                favorite: root.item.favorite;
                toggled => { root.toggle_favorite(); }
            }
        }

        // action
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            width: 100px;
            HorizontalLayout {
                alignment: end;
                if root.is_active : AppButton {
                    text: I18n.t(I18n.lang, "tester.selected_btn");
                    size: "sm";
                    icon: @image-url("../../assets/icons/check.svg");
                    enabled: false;
                }
                if !root.is_active : AppButton {
                    text: I18n.t(I18n.lang, "tester.use_btn");
                    variant: root.item.is_best ? "primary" : "default";
                    size: "sm";
                    enabled: root.item.ok > 0;
                    clicked => { root.use_clicked(); }
                }
            }
        }
    }
}

export component TesterPage inherits Rectangle {
    in property <[TestResultItem]> results;
    in property <bool> running;
    in property <int> current;
    in property <int> total;
    in property <string> current_strategy;
    in property <string> best_id;
    in property <string> selected_strategy;
    in property <bool> installed;
    in property <bool> is_admin;
    in property <int> strategy_count;

    callback start_clicked();
    callback cancel_clicked();
    callback use_strategy(string);
    callback toggle_favorite(string);

    background: transparent;

    property <bool> has-results: root.results.length > 0;

    HorizontalLayout {
        VerticalLayout {
            horizontal-stretch: 0;
            width: min(parent.width, 1044px);
            padding: 32px;
            spacing: 0px;

            // page-head
            VerticalLayout {
                spacing: 8px;
                padding-bottom: 24px;
                Text {
                    text: I18n.t(I18n.lang, "tester.title");
                    font-family: ThemePalette.font-sans;
                    font-size: ThemePalette.fs-28;
                    font-weight: 600;
                    color: ThemePalette.text;
                }
                Text {
                    text: I18n.t(I18n.lang, "tester.subtitle");
                    font-family: ThemePalette.font-sans;
                    font-size: ThemePalette.fs-13;
                    color: ThemePalette.text-2;
                    wrap: word-wrap;
                }
            }
            // ── control card ──
            Rectangle {
                vertical-stretch: 0;
                background: ThemePalette.surface;
                border-width: 1px;
                border-color: ThemePalette.border;
                border-radius: ThemePalette.r-16;
                clip: true;

                VerticalLayout {
                    padding: 24px;
                    spacing: 16px;

                    HorizontalLayout {
                        spacing: 16px;
                        VerticalLayout {
                            horizontal-stretch: 0;
                            alignment: center;
                            Rectangle {
                                width: 48px;
                                height: 48px;
                                border-radius: ThemePalette.r-12;
                                background: ThemePalette.accent-surface;
                                border-width: 1px;
                                border-color: ThemePalette.accent-border;
                                Image {
                                    x: 14px; y: 14px; width: 20px; height: 20px;
                                    source: root.has-results && !root.running
                                        ? @image-url("../../assets/icons/check.svg")
                                        : @image-url("../../assets/icons/rocket.svg");
                                    colorize: ThemePalette.accent-text;
                                }
                            }
                        }
                        // info
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 8px;
                            alignment: center;
                            Text {
                                text: root.running ? I18n.t(I18n.lang, "tester.state_testing") : root.has-results ? I18n.t(I18n.lang, "tester.state_complete") : I18n.t(I18n.lang, "tester.state_ready");
                                font-family: ThemePalette.font-mono;
                                font-size: ThemePalette.fs-11;
                                color: root.running || root.has-results ? ThemePalette.accent-text : ThemePalette.text-3;
                                letter-spacing: 0.8px;
                            }
                            Text {
                                text: root.running
                                        ? I18n.t(I18n.lang, "tester.progress_testing") + root.current + I18n.t(I18n.lang, "tester.progress_of") + root.total + ": " + root.current_strategy
                                        : root.has-results
                                            ? (root.best_id != "" ? I18n.t(I18n.lang, "tester.best_strategy_prefix") + root.best_id : I18n.t(I18n.lang, "tester.none_unblocked"))
                                            : I18n.t(I18n.lang, "tester.ready_desc_a") + root.strategy_count + I18n.t(I18n.lang, "tester.ready_desc_b");
                                font-family: ThemePalette.font-sans;
                                font-size: ThemePalette.fs-14;
                                font-weight: root.running || (root.has-results && root.best_id != "") ? 600 : 400;
                                color: root.has-results && root.best_id != "" && !root.running ? ThemePalette.accent-text : ThemePalette.text-2;
                                wrap: word-wrap;
                            }
                        }
                        // action button
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 0;
                            if root.running : AppButton {
                                text: I18n.t(I18n.lang, "common.cancel");
                                variant: "danger";
                                size: "lg";
                                icon: @image-url("../../assets/icons/stop.svg");
                                clicked => { root.cancel_clicked(); }
                            }
                            if !root.running : AppButton {
                                text: root.has-results ? I18n.t(I18n.lang, "tester.run_again") : I18n.t(I18n.lang, "tester.run_test");
                                variant: "primary";
                                size: "lg";
                                icon: @image-url("../../assets/icons/rocket.svg");
                                enabled: root.installed && root.strategy_count > 0 && root.is_admin;
                                clicked => { root.start_clicked(); }
                            }
                        }
                    }

                    // progress bar (only while running)
                    if root.running : Rectangle {
                        height: 6px;
                        border-radius: ThemePalette.r-4;
                        background: ThemePalette.surface-2;
                        clip: true;
                        Rectangle {
                            x: 0;
                            width: parent.width * root.current / max(root.total, 1);
                            height: parent.height;
                            border-radius: ThemePalette.r-4;
                            background: ThemePalette.accent;
                            animate width { duration: 200ms; easing: ease-out; }
                        }
                    }

                    if !root.installed : Text {
                        text: I18n.t(I18n.lang, "tester.install_first");
                        font-family: ThemePalette.font-mono;
                        font-size: ThemePalette.fs-11;
                        color: ThemePalette.text-3;
                    }
                }
            }

            Rectangle { height: 20px; }

            // ── results list ──
            Rectangle {
                vertical-stretch: 1;
                border-width: 1px;
                border-color: ThemePalette.border;
                border-radius: ThemePalette.r-16;
                background: ThemePalette.surface;
                clip: true;

                VerticalLayout {
                    spacing: 0px;
                    Rectangle {
                        height: 58px;
                        HorizontalLayout {
                            padding-left: 18px;
                            padding-right: 18px;
                            spacing: 10px;
                            Text {
                                text: I18n.t(I18n.lang, "tester.results_title");
                                font-family: ThemePalette.font-sans;
                                font-size: ThemePalette.fs-14;
                                font-weight: 600;
                                color: ThemePalette.text;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Text {
                                text: "\{root.results.length} " + I18n.t(I18n.lang, "tester.results_count_suffix");
                                font-family: ThemePalette.font-mono;
                                font-size: ThemePalette.fs-11;
                                color: ThemePalette.text-3;
                                vertical-alignment: center;
                            }
                        }
                        Rectangle { y: parent.height - 1px; height: 1px; background: ThemePalette.divider; }
                    }

                    if root.has-results : Rectangle {
                        height: 34px;
                        background: ThemePalette.surface-2;
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 12px;
                            Text {
                                width: 30px;
                                text: "#";
                                font-family: ThemePalette.font-mono;
                                font-size: ThemePalette.fs-10;
                                color: ThemePalette.text-3;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            Text {
                                horizontal-stretch: 0;
                                min-width: 120px;
                                preferred-width: 190px;
                                max-width: 190px;
                                text: I18n.t(I18n.lang, "tester.col_strategy");
                                font-family: ThemePalette.font-mono;
                                font-size: ThemePalette.fs-10;
                                color: ThemePalette.text-3;
                                vertical-alignment: center;
                            }
                            Text {
                                horizontal-stretch: 1;
                                min-width: 150px;
                                text: I18n.t(I18n.lang, "tester.col_reachability");
                                font-family: ThemePalette.font-mono;
                                font-size: ThemePalette.fs-10;
                                color: ThemePalette.text-3;
                                vertical-alignment: center;
                            }
                            Rectangle { width: 28px; }
                            Rectangle { width: 100px; }
                        }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                        if !root.has-results : VerticalLayout {
                            alignment: center;
                            padding: 28px;
                            spacing: 10px;
                            Text {
                                text: root.running ? I18n.t(I18n.lang, "tester.collecting") : I18n.t(I18n.lang, "tester.no_results");
                                font-family: ThemePalette.font-sans;
                                font-size: ThemePalette.fs-16;
                                font-weight: 500;
                                color: ThemePalette.text-2;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: root.running ? I18n.t(I18n.lang, "tester.collecting_sub") : I18n.t(I18n.lang, "tester.no_results_sub");
                                font-family: ThemePalette.font-sans;
                                font-size: ThemePalette.fs-12;
                                color: ThemePalette.text-3;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                        }

                        result-list := ListView {
                            viewport-width: result-list.visible-width;
                            for item in root.results : ResultRow {
                                item: item;
                                is_active: root.selected_strategy == item.id;
                                use_clicked => { root.use_strategy(item.id); }
                                toggle_favorite => { root.toggle_favorite(item.id); }
                            }
                        }
                    }
                }
            }
        }
        Rectangle { }
    }
}
