import { ThemePalette } from "../tokens.slint";
import { I18n } from "../i18n.slint";
import { AppButton } from "../components/button.slint";
import { AppInput } from "../components/input.slint";
import { AppSwitch } from "../components/switch.slint";
import { ScrollView } from "std-widgets.slint";

component Caption inherits Text {
    font-family: ThemePalette.font-sans;
    font-size: ThemePalette.fs-12;
    color: ThemePalette.text-2;
    wrap: word-wrap;
}
component Label inherits Text {
    font-family: ThemePalette.font-sans;
    font-size: ThemePalette.fs-13;
    font-weight: 500;
    color: ThemePalette.text;
    wrap: word-wrap;
}

export component TelegramPage inherits Rectangle {
    in property <bool> running;
    in property <bool> busy;
    in property <string> error;
    in property <string> port;
    in property <string> secret;
    in property <string> dc-overrides;
    in property <bool> fallback;
    in property <string> timeout;
    in property <string> limit;
    in property <string> link;
    callback start-clicked();
    callback stop-clicked();
    callback connect-clicked();
    callback copy-clicked();
    callback save-clicked(string, string, string, bool, string, string);

    in-out property <bool> settings-open: false;
    property <bool> saving: false;
    property <string> draft-port;
    property <string> draft-secret;
    property <string> draft-dc;
    property <bool> draft-fallback;
    property <string> draft-timeout;
    property <string> draft-limit;
    changed busy => {
        if (!root.busy && root.saving) {
            root.saving = false;
            if (root.error == "") { root.settings-open = false; }
        }
    }
    function load-draft() {
        root.draft-port = root.port;
        root.draft-secret = root.secret;
        root.draft-dc = root.dc-overrides;
        root.draft-fallback = root.fallback;
        root.draft-timeout = root.timeout;
        root.draft-limit = root.limit;
    }
    changed settings-open => { if (root.settings-open) { root.load-draft(); } }
    init => { root.load-draft(); }

    property <color> telegram-blue: ThemePalette.is-dark ? #62c5f4 : #1377a7;
    property <color> telegram-surface: ThemePalette.is-dark ? #142b38 : #e9f4fb;
    property <color> telegram-border: ThemePalette.is-dark ? #294959 : #bfddec;

    width: 100%; height: 100%;
    background: transparent;
    VerticalLayout {
        padding: 32px;
        spacing: 0px;
        VerticalLayout {
            vertical-stretch: 0;
            spacing: 6px;
            padding-bottom: 24px;
            Text {
                text: I18n.t(I18n.lang, root.settings-open ? "telegram.settings_title" : "telegram.title");
                font-family: ThemePalette.font-sans;
                font-size: ThemePalette.fs-28;
                font-weight: 600;
                color: ThemePalette.text;
            }
            if root.settings-open : Caption {
                text: I18n.t(I18n.lang, root.running ? "telegram.stop_to_edit" : "telegram.settings_hint");
                font-size: ThemePalette.fs-13;
            }
        }
        sv := ScrollView {
            viewport-width: sv.visible-width;
            // Publish the full wrapped form height so Flickable can reach the
            // final fields even when the fixed action footer shortens the view.
            viewport-height: max(sv.visible-height, scroll-content.preferred-height);
            vertical-stretch: 1;
            scroll-content := HorizontalLayout {
                width: sv.visible-width;
                height: sv.viewport-height;
                padding-top: 8px;
                padding-bottom: 24px;
                padding-right: 8px;
                alignment: center;
                VerticalLayout {
                    horizontal-stretch: 0;
                    min-width: 0px;
                    preferred-width: 600px;
                    max-width: 600px;
                    spacing: 18px;
                    alignment: root.settings-open ? start : center;
                    if !root.settings-open : Rectangle {
                        vertical-stretch: 0;
                        background: ThemePalette.surface;
                        border-width: 1px;
                        border-color: ThemePalette.border;
                        border-radius: ThemePalette.r-16;
                        VerticalLayout {
                            padding: 28px;
                            spacing: 18px;
                            alignment: start;
                            HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 56px;
                                    height: 56px;
                                    border-radius: ThemePalette.r-16;
                                    background: root.telegram-surface;
                                    border-width: 1px;
                                    border-color: root.telegram-border;
                                    Image {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        source: @image-url("../../assets/icons/telegram.svg");
                                        width: 32px;
                                        height: 32px;
                                        colorize: root.telegram-blue;
                                    }
                                }
                            }
                            VerticalLayout {
                                spacing: 10px;
                                Text {
                                    text: I18n.t(I18n.lang, root.running ? "telegram.active" : "telegram.inactive");
                                    font-family: ThemePalette.font-sans;
                                    font-size: ThemePalette.fs-22;
                                    font-weight: 600;
                                    color: ThemePalette.text;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }
                                Caption {
                                    text: I18n.t(I18n.lang, "telegram.description");
                                    font-size: ThemePalette.fs-13;
                                    horizontal-alignment: center;
                                }
                            }
                            HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    horizontal-stretch: 0;
                                    height: 30px;
                                    border-radius: ThemePalette.r-full;
                                    background: root.running ? root.telegram-surface : ThemePalette.surface-2;
                                    border-width: 1px;
                                    border-color: root.running ? root.telegram-border : ThemePalette.border;
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 8px;
                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 6px;
                                                height: 6px;
                                                border-radius: 3px;
                                                background: root.running ? root.telegram-blue : ThemePalette.text-3;
                                            }
                                        }
                                        Text {
                                            text: "127.0.0.1:" + root.port;
                                            font-family: ThemePalette.font-mono;
                                            font-size: ThemePalette.fs-12;
                                            color: root.running ? root.telegram-blue : ThemePalette.text-2;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                            Rectangle { height: 1px; background: ThemePalette.divider; }
                            VerticalLayout {
                                spacing: 10px;
                                AppButton {
                                    width: min(sv.visible-width - 8px, 600px) - 56px;
                                    size: "lg";
                                    variant: root.running ? "default" : "telegram";
                                    text: I18n.t(I18n.lang, root.running ? "telegram.stop" : "telegram.start");
                                    icon: root.running ? @image-url("../../assets/icons/stop.svg") : @image-url("../../assets/icons/play.svg");
                                    busy: root.busy;
                                    clicked => { if (root.running) { root.stop-clicked(); } else { root.start-clicked(); } }
                                }
                                HorizontalLayout {
                                    spacing: 10px;
                                    AppButton {
                                        width: (min(sv.visible-width - 8px, 600px) - 66px) / 2;
                                        text: I18n.t(I18n.lang, "telegram.connect");
                                        icon: @image-url("../../assets/icons/telegram.svg");
                                        enabled: root.running && !root.busy && root.link != "";
                                        clicked => { root.connect-clicked(); }
                                    }
                                    AppButton {
                                        width: (min(sv.visible-width - 8px, 600px) - 66px) / 2;
                                        text: I18n.t(I18n.lang, "telegram.copy_link");
                                        icon: @image-url("../../assets/icons/copy.svg");
                                        enabled: root.running && !root.busy && root.link != "";
                                        clicked => { root.copy-clicked(); }
                                    }
                                }
                            }
                            HorizontalLayout {
                                alignment: center;
                                AppButton {
                                    text: I18n.t(I18n.lang, "telegram.settings");
                                    icon: @image-url("../../assets/icons/settings.svg");
                                    variant: "ghost";
                                    enabled: !root.busy;
                                    clicked => { root.settings-open = true; }
                                }
                            }
                        }
                    }
                    if !root.settings-open : Caption {
                        text: I18n.t(I18n.lang, "telegram.lifetime");
                        horizontal-alignment: center;
                    }
                    if root.settings-open : Rectangle {
                        vertical-stretch: 0;
                        background: ThemePalette.surface;
                        border-width: 1px;
                        border-color: ThemePalette.border;
                        border-radius: ThemePalette.r-12;
                        VerticalLayout {
                            padding: 24px;
                            spacing: 22px;
                            alignment: start;
                            VerticalLayout {
                                spacing: 8px;
                                Label { text: I18n.t(I18n.lang, "telegram.port"); }
                                AppInput { text <=> root.draft-port; enabled: !root.running && !root.busy; }
                            }
                            VerticalLayout {
                                spacing: 8px;
                                Label { text: I18n.t(I18n.lang, "telegram.secret"); }
                                AppInput {
                                    text <=> root.draft-secret;
                                    enabled: !root.running && !root.busy;
                                    placeholder: I18n.t(I18n.lang, "telegram.secret_hint");
                                }
                                Caption { text: I18n.t(I18n.lang, "telegram.secret_note"); }
                            }
                            Rectangle { height: 1px; background: ThemePalette.divider; }
                            VerticalLayout {
                                spacing: 8px;
                                Label { text: I18n.t(I18n.lang, "telegram.dc"); }
                                AppInput {
                                    text <=> root.draft-dc;
                                    enabled: !root.running && !root.busy;
                                    placeholder: "2:149.154.167.220 4:149.154.167.220";
                                }
                                Caption { text: I18n.t(I18n.lang, "telegram.dc_hint"); }
                            }
                            HorizontalLayout {
                                spacing: 16px;
                                VerticalLayout {
                                    spacing: 8px;
                                    Label { text: I18n.t(I18n.lang, "telegram.timeout"); }
                                    AppInput { text <=> root.draft-timeout; enabled: !root.running && !root.busy; }
                                }
                                VerticalLayout {
                                    spacing: 8px;
                                    Label { text: I18n.t(I18n.lang, "telegram.limit"); }
                                    AppInput { text <=> root.draft-limit; enabled: !root.running && !root.busy; }
                                }
                            }
                            Rectangle { height: 1px; background: ThemePalette.divider; }
                            HorizontalLayout {
                                spacing: 20px;
                                VerticalLayout {
                                    spacing: 5px;
                                    horizontal-stretch: 1;
                                    Label { text: I18n.t(I18n.lang, "telegram.fallback"); }
                                    Caption { text: I18n.t(I18n.lang, "telegram.fallback_hint"); }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 0;
                                    AppSwitch { checked <=> root.draft-fallback; enabled: !root.running && !root.busy; }
                                }
                            }
                        }
                    }
                    if root.error != "" : Rectangle {
                        vertical-stretch: 0;
                        background: ThemePalette.danger-soft;
                        border-width: 1px;
                        border-color: ThemePalette.danger-line;
                        border-radius: ThemePalette.r-10;
                        HorizontalLayout {
                            padding: 14px;
                            spacing: 10px;
                            Image {
                                source: @image-url("../../assets/icons/warning.svg");
                                width: 16px;
                                height: 16px;
                                colorize: ThemePalette.danger-text;
                            }
                            Caption {
                                text: I18n.t(I18n.lang, root.error);
                                color: ThemePalette.danger-text;
                                horizontal-stretch: 1;
                            }
                        }
                    }
                }
            }
        }
        if root.settings-open : Rectangle {
            height: 64px;
            Rectangle { x: 0; y: 0; width: parent.width; height: 1px; background: ThemePalette.divider; }
            HorizontalLayout {
                padding-top: 16px;
                padding-bottom: 12px;
                spacing: 12px;
                alignment: end;
                AppButton {
                    text: I18n.t(I18n.lang, "telegram.back");
                    enabled: !root.busy;
                    clicked => { root.settings-open = false; }
                }
                AppButton {
                    text: I18n.t(I18n.lang, "telegram.save");
                    variant: "telegram";
                    enabled: !root.running;
                    busy: root.busy;
                    clicked => {
                        root.saving = true;
                        root.save-clicked(root.draft-port, root.draft-secret, root.draft-dc, root.draft-fallback, root.draft-timeout, root.draft-limit);
                    }
                }
            }
        }
    }
}
