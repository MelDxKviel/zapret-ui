import { ThemePalette, StrategyItem } from "../tokens.slint";
import { I18n } from "../i18n.slint";
import { AppButton } from "../components/button.slint";
import { AppInput } from "../components/input.slint";
import { StarToggle } from "../components/star.slint";
import { ListView } from "std-widgets.slint";

export component StrategiesPage inherits Rectangle {
    in property <[StrategyItem]> strategies_model;
    in property <string> active_strategy_id;
    in property <string> selected_strategy;
    in property <bool> is_busy;
    in-out property <string> query;

    callback picked(StrategyItem);
    callback search_changed(string);
    callback toggle_favorite(string);

    background: transparent;
    pure function pad2(n: int) -> string { return n < 10 ? "0\{n}" : "\{n}"; }

    HorizontalLayout {
        VerticalLayout {
            horizontal-stretch: 0;
            width: min(parent.width, 1044px);
            padding: 32px;
            spacing: 24px;

            VerticalLayout {
                spacing: 8px;
                Text {
                    text: I18n.t(I18n.lang, "strategies.title");
                    font-family: ThemePalette.font-sans;
                    font-size: ThemePalette.fs-28;
                    font-weight: 600;
                    color: ThemePalette.text;
                }
                Text {
                    text: I18n.t(I18n.lang, "strategies.subtitle");
                    font-family: ThemePalette.font-sans;
                    font-size: ThemePalette.fs-13;
                    color: ThemePalette.text-2;
                    wrap: word-wrap;
                }
            }

            Rectangle {
                vertical-stretch: 1;
                border-width: 1px;
                border-color: ThemePalette.border;
                border-radius: ThemePalette.r-16;
                background: ThemePalette.surface;
                clip: true;

                VerticalLayout {
                    spacing: 0px;
                    Rectangle {
                        height: 108px;
                        background: ThemePalette.surface;
                        VerticalLayout {
                            padding: 18px;
                            spacing: 12px;
                            HorizontalLayout {
                                spacing: 10px;
                                Text {
                                    text: I18n.t(I18n.lang, "strategies.list_title");
                                    font-family: ThemePalette.font-sans;
                                    font-size: ThemePalette.fs-14;
                                    font-weight: 600;
                                    color: ThemePalette.text;
                                    vertical-alignment: center;
                                }
                                Rectangle { horizontal-stretch: 1; }
                                Text {
                                    text: "\{root.strategies_model.length} " + I18n.t(I18n.lang, "strategies.count_suffix");
                                    font-family: ThemePalette.font-mono;
                                    font-size: ThemePalette.fs-11;
                                    color: ThemePalette.text-3;
                                    vertical-alignment: center;
                                }
                            }
                            AppInput {
                                field-height: 38px;
                                icon: @image-url("../../assets/icons/search.svg");
                                placeholder: I18n.t(I18n.lang, "strategies.search_placeholder");
                                text <=> root.query;
                                edited(t) => { root.search_changed(t); }
                                if root.query != "" : AppButton {
                                    text: I18n.t(I18n.lang, "common.clear_lower");
                                    variant: "ghost";
                                    size: "sm";
                                    clicked => { root.query = ""; root.search_changed(""); }
                                }
                            }
                        }
                        Rectangle { y: parent.height - 1px; height: 1px; background: ThemePalette.divider; }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                        if root.strategies_model.length == 0 : VerticalLayout {
                            alignment: center;
                            padding: 28px;
                            spacing: 14px;
                            HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 48px;
                                    height: 48px;
                                    border-radius: ThemePalette.r-12;
                                    background: ThemePalette.surface-2;
                                    Image {
                                        x: 14px; y: 14px; width: 20px; height: 20px;
                                        source: @image-url("../../assets/icons/search.svg");
                                        colorize: ThemePalette.text-3;
                                    }
                                }
                            }
                            Text {
                                text: I18n.t(I18n.lang, "strategies.no_match_a") + root.query + I18n.t(I18n.lang, "strategies.no_match_b");
                                font-family: ThemePalette.font-sans;
                                font-size: ThemePalette.fs-13;
                                color: ThemePalette.text-2;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                        }

                        list := ListView {
                            // Long descriptions must never widen the scrollable viewport.
                            viewport-width: list.visible-width;
                            for item[idx] in root.strategies_model : row := Rectangle {
                                property <bool> is-active: root.active_strategy_id == item.id;
                                property <bool> is-selected: root.selected_strategy == item.id;
                                height: 78px;
                                background: row.is-selected || row.is-active ? ThemePalette.accent-surface
                                    : row-ta.has-hover ? ThemePalette.surface-hover : ThemePalette.surface;
                                animate background { duration: 120ms; }

                                Rectangle { y: parent.height - 1px; height: 1px; background: ThemePalette.divider; }

                                row-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.picked(item); }
                                }

                                HorizontalLayout {
                                    padding-left: 18px;
                                    padding-right: 18px;
                                    spacing: 14px;
                                    Text {
                                        width: 26px;
                                        text: root.pad2(idx + 1);
                                        font-family: ThemePalette.font-mono;
                                        font-size: ThemePalette.fs-11;
                                        color: row.is-selected || row.is-active ? ThemePalette.accent-text : ThemePalette.text-3;
                                        vertical-alignment: center;
                                    }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        min-width: 0px;
                                        alignment: center;
                                        spacing: 6px;
                                        HorizontalLayout {
                                            spacing: 8px;
                                            alignment: start;
                                            Text {
                                                min-width: 0px;
                                                text: item.pretty;
                                                font-family: ThemePalette.font-mono;
                                                font-size: ThemePalette.fs-13;
                                                font-weight: 600;
                                                color: ThemePalette.text;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                            if item.alt != "" : Rectangle {
                                                horizontal-stretch: 0;
                                                width: min(chip-txt.preferred-width + 14px, 130px);
                                                height: 21px;
                                                border-radius: ThemePalette.r-6;
                                                border-width: 1px;
                                                border-color: row.is-selected || row.is-active ? ThemePalette.accent-border : ThemePalette.border;
                                                background: ThemePalette.surface;
                                                chip-txt := Text {
                                                    text: item.alt;
                                                    font-family: ThemePalette.font-mono;
                                                    font-size: ThemePalette.fs-10;
                                                    color: row.is-selected || row.is-active ? ThemePalette.accent-text : ThemePalette.text-2;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                }
                                            }
                                        }
                                        Text {
                                            min-width: 0px;
                                            text: item.description;
                                            font-family: ThemePalette.font-sans;
                                            font-size: ThemePalette.fs-12;
                                            color: ThemePalette.text-2;
                                            overflow: elide;
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 0;
                                        StarToggle {
                                            favorite: item.favorite;
                                            toggled => { root.toggle_favorite(item.id); }
                                        }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        horizontal-stretch: 0;
                                        width: 112px;
                                        HorizontalLayout {
                                            alignment: end;
                                            if row.is-active : AppButton {
                                                text: I18n.t(I18n.lang, "strategies.active_btn");
                                                size: "sm";
                                                icon: @image-url("../../assets/icons/check.svg");
                                                enabled: false;
                                            }
                                            if row.is-selected && !row.is-active : Rectangle {
                                                horizontal-stretch: 0;
                                                width: selected-label.preferred-width + 24px;
                                                height: 30px;
                                                border-radius: ThemePalette.r-8;
                                                border-width: 1px;
                                                border-color: ThemePalette.accent-border;
                                                background: ThemePalette.accent-surface;
                                                selected-label := Text {
                                                    text: I18n.t(I18n.lang, "strategies.selected_btn");
                                                    font-family: ThemePalette.font-sans;
                                                    font-size: ThemePalette.fs-12;
                                                    font-weight: 500;
                                                    color: ThemePalette.accent-text;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                                TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { root.picked(item); }
                                                }
                                            }
                                            if !row.is-active && !row.is-selected : AppButton {
                                                text: I18n.t(I18n.lang, "strategies.select_btn");
                                                size: "sm";
                                                clicked => { root.picked(item); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        Rectangle { }
    }
}
