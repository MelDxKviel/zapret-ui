import { ThemePalette } from "../tokens.slint";
import { I18n } from "../i18n.slint";
import { AppSwitch } from "../components/switch.slint";
import { AppButton } from "../components/button.slint";
import { Segmented, SegmentOption } from "../components/segmented.slint";
import { Icon } from "../components/icon.slint";
import { ScrollView } from "std-widgets.slint";

component SettingsGroup inherits Rectangle {
    in property <string> title;
    in property <image> icon;
    background: ThemePalette.surface;
    border-width: 1px;
    border-color: ThemePalette.border;
    border-radius: ThemePalette.r-12;
    clip: true;
    vertical-stretch: 0;
    VerticalLayout {
        alignment: start;
        Rectangle {
            height: 58px;
            background: ThemePalette.surface;
            HorizontalLayout {
                padding-left: 20px;
                padding-right: 20px;
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 0;
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: ThemePalette.r-8;
                        background: ThemePalette.accent-surface;
                        Icon {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            source: root.icon;
                            size: 15px;
                            tint: ThemePalette.accent-text;
                        }
                    }
                }
                Text {
                    text: root.title;
                    font-family: ThemePalette.font-sans;
                    font-size: ThemePalette.fs-14;
                    font-weight: 600;
                    color: ThemePalette.text;
                    vertical-alignment: center;
                }
            }
            Rectangle { x: 20px; y: parent.height - 1px; width: parent.width - 40px; height: 1px; background: ThemePalette.divider; }
        }
        @children
    }
}

component SettingsRow inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <bool> last: false;
    // Reserve the measured wrapped text height, including its row padding.
    // The minimum alone suppresses the implicit height-for-width constraint.
    height: max(78px, row.preferred-height);
    vertical-stretch: 0;
    row := HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        padding-top: 16px;
        padding-bottom: 16px;
        spacing: 24px;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 5px;
            alignment: center;
            Text {
                text: root.label;
                font-family: ThemePalette.font-sans;
                font-size: ThemePalette.fs-14;
                font-weight: 500;
                color: ThemePalette.text;
                wrap: word-wrap;
            }
            Text {
                text: root.hint;
                font-family: ThemePalette.font-sans;
                font-size: ThemePalette.fs-12;
                color: ThemePalette.text-2;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            horizontal-stretch: 0;
            alignment: center;
            @children
        }
    }
    if !root.last : Rectangle { x: 20px; y: parent.height - 1px; width: parent.width - 40px; height: 1px; background: ThemePalette.divider; }
}

export component SettingsPage inherits Rectangle {
    in-out property <bool> show_telegram_proxy;
    in-out property <bool> telegram_autostart;
    callback telegram_visibility_changed(bool);
    callback telegram_autostart_changed(bool);
    in-out property <bool> autostart;
    in-out property <bool> autoupdate_check;
    in-out property <bool> minimize_to_tray;
    in-out property <bool> notifications;
    in-out property <bool> autoengage;
    in-out property <bool> compact;
    in-out property <string> install_dir;
    in-out property <string> theme; // "dark" | "light" | "system"

    // ── App self-update (zapret-ui itself) ──
    in property <string> app_version;
    in property <bool> app_has_update;
    in property <string> app_latest_version;
    in property <bool> app_update_checking;
    in property <bool> app_update_downloading;
    in property <float> app_update_progress;
    in property <bool> app_update_checked;
    in property <bool> app_update_ok;
    in property <string> app_update_msg;

    // ── DPI bypass tuning (zapret service.bat filters) ──
    in property <bool> installed;
    in-out property <string> game_filter; // off | all | tcp | udp
    in-out property <string> ipset_mode;  // any | none | loaded | unknown
    in property <int> ipset_lines;
    in property <bool> ipset_busy;
    in property <string> ipset_msg;
    in property <bool> ipset_ok;
    in property <bool> hosts_busy;
    in property <string> hosts_msg;
    in property <bool> hosts_ok;
    in property <bool> discord_busy;
    in property <string> discord_msg;
    in property <bool> discord_ok;

    callback open_folder_clicked();
    callback app_check_update_clicked();
    callback app_update_clicked();
    callback theme_changed(string);
    callback language_changed(string);
    callback notifications_changed(bool);
    callback autostart_changed(bool);
    callback autoupdate_changed(bool);
    callback tray_changed(bool);
    callback autoengage_changed(bool);
    callback game_filter_changed(string);
    callback ipset_mode_changed(string);
    callback update_ipset_clicked();
    callback update_hosts_clicked();
    callback clear_discord_cache_clicked();
    callback open_ipset_file_clicked();
    callback open_hosts_file_clicked();

    background: transparent;

    sv := ScrollView {
        viewport-width: sv.visible-width;
        HorizontalLayout {
            VerticalLayout {
                horizontal-stretch: 0;
                width: min(sv.visible-width, 1040px);
                padding-left: 32px;
                padding-top: 32px;
                padding-right: 32px;
                padding-bottom: 60px;
                spacing: 0px;
                alignment: start;

                // page-head
                VerticalLayout {
                    spacing: 6px;
                    padding-bottom: 24px;
                    Text {
                        text: I18n.t(I18n.lang, "settings.title");
                        font-family: ThemePalette.font-sans;
                        font-size: ThemePalette.fs-28;
                        font-weight: 600;
                        color: ThemePalette.text;
                    }
                    Text {
                        text: I18n.t(I18n.lang, "settings.subtitle");
                        font-family: ThemePalette.font-sans;
                        font-size: ThemePalette.fs-13;
                        color: ThemePalette.text-2;
                        wrap: word-wrap;
                    }
                }

                // Appearance
                SettingsGroup {
                    title: I18n.t(I18n.lang, "settings.group_appearance");
                    icon: @image-url("../../assets/icons/sun.svg");
                    SettingsRow {
                        label: I18n.t(I18n.lang, "settings.language_label");
                        hint: I18n.t(I18n.lang, "settings.language_hint");
                        Segmented {
                            selected: I18n.lang;
                            options: [
                                { value: "ru", label: "Русский" },
                                { value: "en", label: "English" },
                            ];
                            changed(v) => { I18n.lang = v; root.language_changed(v); }
                        }
                    }
                    SettingsRow {
                        label: I18n.t(I18n.lang, "settings.theme_label");
                        hint: I18n.t(I18n.lang, "settings.theme_hint");
                        last: true;
                        Segmented {
                            selected: root.theme;
                            options: [
                                { value: "dark",   label: I18n.t(I18n.lang, "settings.theme_dark"),   icon: @image-url("../../assets/icons/moon.svg") },
                                { value: "light",  label: I18n.t(I18n.lang, "settings.theme_light"),  icon: @image-url("../../assets/icons/sun.svg") },
                                { value: "system", label: I18n.t(I18n.lang, "settings.theme_system"), icon: @image-url("../../assets/icons/system.svg") },
                            ];
                            changed(v) => { root.theme = v; root.theme_changed(v); }
                        }
                    }
                }
                Rectangle { height: 18px; }

                // Application
                SettingsGroup {
                    title: I18n.t(I18n.lang, "settings.group_application");
                    icon: @image-url("../../assets/icons/rocket.svg");
                    SettingsRow {
                        label: I18n.t(I18n.lang, "settings.autostart_label");
                        hint: I18n.t(I18n.lang, "settings.autostart_hint");
                        AppSwitch {
                            checked <=> root.autostart;
                            toggled(v) => { root.autostart_changed(v); }
                        }
                    }
                    SettingsRow {
                        label: I18n.t(I18n.lang, "settings.tray_label");
                        hint: I18n.t(I18n.lang, "settings.tray_hint");
                        AppSwitch {
                            checked <=> root.minimize_to_tray;
                            toggled(v) => { root.tray_changed(v); }
                        }
                    }
                    SettingsRow {
                        label: I18n.t(I18n.lang, "settings.notifications_label");
                        hint: I18n.t(I18n.lang, "settings.notifications_hint");
                        AppSwitch {
                            checked <=> root.notifications;
                            toggled(v) => { root.notifications_changed(v); }
                        }
                    }
                    SettingsRow {
                        label: I18n.t(I18n.lang, "settings.autoengage_label");
                        hint: I18n.t(I18n.lang, "settings.autoengage_hint");
                        last: true;
                        AppSwitch {
                            checked <=> root.autoengage;
                            toggled(v) => { root.autoengage_changed(v); }
                        }
                    }
                }
                Rectangle { height: 18px; }

                // Telegram is independent of the core's startup preference.
                SettingsGroup {
                    title: I18n.t(I18n.lang, "settings.group_telegram");
                    icon: @image-url("../../assets/icons/telegram.svg");
                    SettingsRow {
                        label: I18n.t(I18n.lang, "telegram.visibility_label");
                        hint: I18n.t(I18n.lang, "telegram.visibility_hint");
                        AppSwitch {
                            checked <=> root.show_telegram_proxy;
                            toggled(v) => { root.telegram_visibility_changed(v); }
                        }
                    }
                    SettingsRow {
                        label: I18n.t(I18n.lang, "telegram.autostart_label");
                        hint: I18n.t(I18n.lang, "telegram.autostart_hint");
                        last: true;
                        AppSwitch {
                            checked <=> root.telegram_autostart;
                            enabled: root.show_telegram_proxy;
                            toggled(v) => { root.telegram_autostart_changed(v); }
                        }
                    }
                }
                Rectangle { height: 18px; }

                // Updates & paths
                SettingsGroup {
                    title: I18n.t(I18n.lang, "settings.group_updates");
                    icon: @image-url("../../assets/icons/download.svg");
                    SettingsRow {
                        label: I18n.t(I18n.lang, "update.settings_label");
                        hint: I18n.t(I18n.lang, "update.settings_hint");
                        VerticalLayout {
                            spacing: 6px;
                            alignment: center;
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: end;
                                VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: root.app_version;
                                        width: 108px;
                                        overflow: elide;
                                        horizontal-alignment: right;
                                        font-family: ThemePalette.font-mono;
                                        font-size: ThemePalette.fs-12;
                                        color: ThemePalette.text-3;
                                        vertical-alignment: center;
                                    }
                                }
                                AppButton {
                                    text: root.app_has_update
                                        ? (root.app_update_downloading
                                            ? I18n.t(I18n.lang, "update.downloading")
                                            : I18n.t(I18n.lang, "common.update"))
                                        : (root.app_update_checking
                                            ? I18n.t(I18n.lang, "settings.checking")
                                            : I18n.t(I18n.lang, "update.check_btn"));
                                    variant: root.app_has_update ? "primary" : "default";
                                    icon: root.app_has_update
                                        ? @image-url("../../assets/icons/download.svg")
                                        : @image-url("../../assets/icons/refresh.svg");
                                    busy: root.app_update_checking || root.app_update_downloading;
                                    enabled: !root.app_update_checking && !root.app_update_downloading;
                                    clicked => {
                                        if (root.app_has_update) {
                                            root.app_update_clicked();
                                        } else {
                                            root.app_check_update_clicked();
                                        }
                                    }
                                }
                            }
                            if (!root.app_update_ok && root.app_update_msg != "") || root.app_has_update || root.app_update_checked : Text {
                                text: (!root.app_update_ok && root.app_update_msg != "")
                                    ? root.app_update_msg
                                    : (root.app_has_update
                                        ? I18n.t(I18n.lang, "update.available_prefix") + root.app_latest_version
                                        : I18n.t(I18n.lang, "update.up_to_date"));
                                width: 240px;
                                horizontal-alignment: right;
                                wrap: word-wrap;
                                font-family: ThemePalette.font-sans;
                                font-size: ThemePalette.fs-12;
                                color: (!root.app_update_ok && root.app_update_msg != "")
                                    ? ThemePalette.danger-text
                                    : ThemePalette.text-3;
                            }
                        }
                    }
                    SettingsRow {
                        label: I18n.t(I18n.lang, "settings.autoupdate_label");
                        hint: I18n.t(I18n.lang, "settings.autoupdate_hint");
                        AppSwitch {
                            checked <=> root.autoupdate_check;
                            toggled(v) => { root.autoupdate_changed(v); }
                        }
                    }
                    SettingsRow {
                        label: I18n.t(I18n.lang, "settings.installdir_label");
                        hint: I18n.t(I18n.lang, "settings.installdir_hint");
                        last: true;
                        HorizontalLayout {
                            spacing: 8px;
                            Rectangle {
                                horizontal-stretch: 0;
                                width: 240px;
                                height: 32px;
                                border-radius: ThemePalette.r-8;
                                border-width: 1px;
                                border-color: ThemePalette.border;
                                background: ThemePalette.bg-2;
                                clip: true;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 8px;
                                    Icon {
                                        source: @image-url("../../assets/icons/folder.svg");
                                        size: 13px;
                                        tint: ThemePalette.text-3;
                                    }
                                    Text {
                                        text: root.install_dir != "" ? root.install_dir : "%APPDATA%\\zapret-ui\\zapret";
                                        font-family: ThemePalette.font-mono;
                                        font-size: ThemePalette.fs-12;
                                        color: ThemePalette.text-2;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }
                            AppButton {
                                text: I18n.t(I18n.lang, "common.open");
                                icon: @image-url("../../assets/icons/external.svg");
                                clicked => { root.open_folder_clicked(); }
                            }
                        }
                    }
                }
                Rectangle { height: 18px; }

                // DPI bypass tuning — the zapret service.bat filters & updaters.
                SettingsGroup {
                    title: I18n.t(I18n.lang, "settings.group_dpi");
                    icon: @image-url("../../assets/icons/filter.svg");
                    if !I18n.macos : SettingsRow {
                        label: I18n.t(I18n.lang, "common.game_filter");
                        hint: root.installed
                            ? I18n.t(I18n.lang, "settings.gf_hint")
                            : I18n.t(I18n.lang, "common.game_filter_hint_install");
                        Segmented {
                            enabled: root.installed;
                            selected: root.game_filter;
                            options: [
                                { value: "off", label: I18n.t(I18n.lang, "common.gf_off") },
                                { value: "all", label: I18n.t(I18n.lang, "common.gf_all") },
                                { value: "tcp", label: I18n.t(I18n.lang, "common.gf_tcp") },
                                { value: "udp", label: I18n.t(I18n.lang, "common.gf_udp") },
                            ];
                            changed(v) => { root.game_filter = v; root.game_filter_changed(v); }
                        }
                    }
                    SettingsRow {
                        label: I18n.t(I18n.lang, "settings.ipset_label");
                        hint: root.ipset_mode == "loaded"
                            ? I18n.t(I18n.lang, "settings.ipset_hint_loaded_a") + root.ipset_lines + I18n.t(I18n.lang, "settings.ipset_hint_loaded_b")
                            : (root.ipset_mode == "none"
                                ? I18n.t(I18n.lang, "settings.ipset_hint_none")
                                : (root.ipset_mode == "any"
                                    ? I18n.t(I18n.lang, "settings.ipset_hint_any")
                                    : I18n.t(I18n.lang, "settings.ipset_hint_default")));
                        Segmented {
                            enabled: root.installed && root.ipset_mode != "unknown";
                            selected: root.ipset_mode;
                            options: [
                                { value: "loaded", label: I18n.t(I18n.lang, "settings.ipset_loaded") },
                                { value: "none", label: I18n.t(I18n.lang, "settings.ipset_none") },
                                { value: "any", label: I18n.t(I18n.lang, "settings.ipset_any") },
                            ];
                            changed(v) => { root.ipset_mode = v; root.ipset_mode_changed(v); }
                        }
                    }
                    SettingsRow {
                        label: I18n.t(I18n.lang, "settings.update_ipset_label");
                        hint: I18n.t(I18n.lang, "settings.update_ipset_hint");
                        VerticalLayout {
                            spacing: 6px;
                            alignment: center;
                            HorizontalLayout {
                                alignment: end;
                                spacing: 8px;
                                AppButton {
                                    text: I18n.t(I18n.lang, "common.open");
                                    variant: "ghost";
                                    icon: @image-url("../../assets/icons/external.svg");
                                    enabled: root.installed;
                                    clicked => { root.open_ipset_file_clicked(); }
                                }
                                AppButton {
                                    text: root.ipset_busy ? I18n.t(I18n.lang, "settings.updating") : I18n.t(I18n.lang, "common.update");
                                    icon: @image-url("../../assets/icons/download.svg");
                                    enabled: root.installed && !root.ipset_busy;
                                    clicked => { root.update_ipset_clicked(); }
                                }
                            }
                            if root.ipset_msg != "" : Text {
                                text: root.ipset_msg;
                                width: 240px;
                                horizontal-alignment: right;
                                wrap: word-wrap;
                                font-family: ThemePalette.font-sans;
                                font-size: ThemePalette.fs-12;
                                color: root.ipset_ok ? ThemePalette.text-3 : ThemePalette.danger-text;
                            }
                        }
                    }
                    SettingsRow {
                        label: I18n.t(I18n.lang, "settings.update_hosts_label");
                        hint: I18n.t(I18n.lang, "settings.update_hosts_hint");
                        VerticalLayout {
                            spacing: 6px;
                            alignment: center;
                            HorizontalLayout {
                                alignment: end;
                                spacing: 8px;
                                AppButton {
                                    text: I18n.t(I18n.lang, "common.open");
                                    variant: "ghost";
                                    icon: @image-url("../../assets/icons/external.svg");
                                    clicked => { root.open_hosts_file_clicked(); }
                                }
                                AppButton {
                                    text: root.hosts_busy ? I18n.t(I18n.lang, "settings.updating") : I18n.t(I18n.lang, "settings.check_update");
                                    icon: @image-url("../../assets/icons/refresh.svg");
                                    enabled: !root.hosts_busy;
                                    clicked => { root.update_hosts_clicked(); }
                                }
                            }
                            if root.hosts_msg != "" : Text {
                                text: root.hosts_msg;
                                width: 240px;
                                horizontal-alignment: right;
                                wrap: word-wrap;
                                font-family: ThemePalette.font-sans;
                                font-size: ThemePalette.fs-12;
                                color: root.hosts_ok ? ThemePalette.text-3 : ThemePalette.danger-text;
                            }
                        }
                    }
                    SettingsRow {
                        label: I18n.t(I18n.lang, "settings.discord_cache_label");
                        hint: I18n.t(I18n.lang, "settings.discord_cache_hint");
                        last: true;
                        VerticalLayout {
                            spacing: 6px;
                            alignment: center;
                            HorizontalLayout {
                                alignment: end;
                                AppButton {
                                    text: root.discord_busy ? I18n.t(I18n.lang, "settings.clearing") : I18n.t(I18n.lang, "common.clear");
                                    icon: @image-url("../../assets/icons/trash.svg");
                                    enabled: !root.discord_busy;
                                    clicked => { root.clear_discord_cache_clicked(); }
                                }
                            }
                            if root.discord_msg != "" : Text {
                                text: root.discord_msg;
                                width: 240px;
                                horizontal-alignment: right;
                                wrap: word-wrap;
                                font-family: ThemePalette.font-sans;
                                font-size: ThemePalette.fs-12;
                                color: root.discord_ok ? ThemePalette.text-3 : ThemePalette.danger-text;
                            }
                        }
                    }
                }
                Rectangle { height: 18px; }

            }
            Rectangle { }
        }
    }
}
