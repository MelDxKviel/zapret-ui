// Bundle Geist (sans) + Geist Mono at compile time.
import "assets/fonts/Geist-Regular.ttf";
import "assets/fonts/Geist-Medium.ttf";
import "assets/fonts/Geist-SemiBold.ttf";
import "assets/fonts/Geist-Bold.ttf";
import "assets/fonts/GeistMono-Regular.ttf";
import "assets/fonts/GeistMono-Medium.ttf";

import { ThemePalette, AppStatus, StrategyItem, LogLineItem, TestResultItem } from "tokens.slint";
import { Palette } from "std-widgets.slint";
import { I18n } from "i18n.slint";
import { BrandMark } from "components/brand_mark.slint";
import { StatusDot } from "components/status_dot.slint";
import { HostsDialog } from "components/hosts_dialog.slint";
import { TelegramPage } from "pages/telegram.slint";
import { AdminBanner } from "components/admin_banner.slint";
import { UpdateBanner } from "components/update_banner.slint";
import { ModeToggle } from "components/mode_toggle.slint";
import { HomePage } from "pages/home.slint";
import { SimpleModePage } from "pages/simple.slint";
import { StrategiesPage } from "pages/strategies.slint";
import { TesterPage } from "pages/tester.slint";
import { SettingsPage } from "pages/settings.slint";
import { LogsPage } from "pages/logs.slint";
import { AboutPage } from "pages/about.slint";

export { StrategyItem, AppStatus, LogLineItem, TestResultItem, I18n }

// ── Sidebar nav row ──
component NavItem inherits Rectangle {
    in property <bool> branded: false;
    in property <color> accent: ThemePalette.accent;
    in property <string> label;
    in property <image> icon;
    in property <bool> active;
    // Draws an accent dot on the right to nudge the user toward this tab (used to
    // point a freshly-installed user at Strategies). Suppressed once active.
    in property <bool> attention: false;
    callback clicked;

    height: 42px;
    border-radius: ThemePalette.r-8;
    border-width: root.active ? 1px : 0px;
    border-color: root.branded ? ThemePalette.info-soft : ThemePalette.accent-border;
    background: root.active ? (root.branded ? ThemePalette.info-soft : ThemePalette.accent-surface)
        : (ta.has-hover ? ThemePalette.surface-hover : transparent);
    animate background { duration: 120ms; }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            width: 16px;
            Image {
                source: root.icon;
                width: 16px;
                height: 16px;
                colorize: root.branded ? root.accent : root.active ? ThemePalette.accent-text : ThemePalette.text-3;
                animate colorize { duration: 120ms; }
            }
        }
        Text {
            text: root.label;
            font-family: ThemePalette.font-sans;
            font-size: ThemePalette.fs-13;
            font-weight: root.active ? 600 : 500;
            color: root.branded ? root.accent : (root.active ? ThemePalette.accent-text : ThemePalette.text-2);
            vertical-alignment: center;
            animate color { duration: 120ms; }
        }
        Rectangle { horizontal-stretch: 1; }
        if root.attention && !root.active : VerticalLayout {
            alignment: center;
            Rectangle {
                width: 7px;
                height: 7px;
                border-radius: 3.5px;
                background: root.accent;
            }
        }
    }
}

// ── Sidebar theme toggle (sun / moon / system) ──
component ThemeToggleBtn inherits Rectangle {
    in property <image> icon;
    in property <bool> active;
    callback clicked;
    horizontal-stretch: 1;
    // No fixed height: fill the toolbar row so the icon stays vertically centered
    // (a HorizontalLayout top-aligns fixed-height children — see BrandMark).
    border-radius: ThemePalette.r-6;
    border-width: root.active ? 1px : 0px;
    border-color: ThemePalette.border;
    background: root.active ? ThemePalette.surface : (theme-ta.has-hover ? ThemePalette.surface-hover : transparent);
    animate background { duration: 120ms; }
    Image {
        source: root.icon;
        width: 15px; height: 15px;
        colorize: root.active ? ThemePalette.text : ThemePalette.text-3;
    }
    theme-ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Lightweight page containers: no opacity layers or page-sized animations.
component Fade inherits Rectangle {
    width: 100%;
    height: 100%;
    background: transparent;
    @children
}

// The inactive dashboard is removed by the parent's conditional item.
component ModeFade inherits Rectangle {
    background: transparent;
    inner := Rectangle {
        width: 100%;
        height: 100%;
        @children
    }
}

export component MainWindow inherits Window {
    title: "zapret-ui";
    icon: root.app_icon;
    preferred-width: 1080px;
    preferred-height: 880px;
    min-width: 920px;
    min-height: 640px;
    background: ThemePalette.bg;

    // Window/taskbar icon (set from Rust).
    in property <image> app_icon;
    // This app's version string (from Cargo, set by Rust).
    in-out property <string> app_version: "";
    // This app's GitHub repository URL (from Cargo, set by Rust).
    in-out property <string> repo_url: "";

    // ── Status (set from Rust) ──
    in-out property <bool> status_installed: false;
    in-out property <string> status_installed_version: "";
    in-out property <string> status_running_mode: "None";
    in-out property <string> status_active_strategy: "";
    in-out property <int> status_winws_pid: 0;
    in-out property <bool> status_service_installed: false;
    // Authoritative bypass uptime in seconds (from the OS, via Rust). Re-synced
    // on every status poll; the UI ticks `uptime` locally between polls.
    in-out property <int> status_uptime: 0;

    in-out property <float> progress: 0.0;
    in-out property <bool> is_busy: false;
    // Which bypass transition is in flight: "start" | "stop" | "". Set the instant
    // the user clicks (for immediate spinner feedback) and cleared by Rust when the
    // resulting status/error lands and flips `is_busy` back off.
    in-out property <string> pending_op: "";
    changed is_busy => { if (!root.is_busy) { root.pending_op = ""; } }
    in-out property <bool> has_update: false;
    in-out property <string> latest_version: "";

    // ── App self-update (zapret-ui itself; set from Rust) ──
    in-out property <bool> app_has_update: false;
    in-out property <string> app_latest_version: "";
    // UI-local: the user dismissed the home banner (the X). Reset on a new check.
    in-out property <bool> app_update_dismissed: false;
    in-out property <bool> app_update_checking: false;
    in-out property <bool> app_update_downloading: false;
    in-out property <float> app_update_progress: 0.0;
    // A self-update check has completed at least once (drives "up to date" copy).
    in-out property <bool> app_update_checked: false;
    in-out property <bool> app_update_ok: true;
    in-out property <string> app_update_msg: "";

    // Whether this process is elevated. When false, the admin banner shows and
    // the admin-only actions (Engage, Tester, Windows service) are disabled.
    in-out property <bool> is_admin: true;
    // Windows toast notifications on bypass start/stop (Settings → Application).
    in-out property <bool> notifications: true;

    // Telegram is independent of the core's busy/running state.
    in-out property <bool> show_telegram_proxy: true;
    in-out property <bool> telegram_autostart: false;
    in-out property <bool> telegram_settings_open: false;
    changed current_page => {
        if (root.current_page != "telegram") { root.telegram_settings_open = false; }
    }
    in-out property <bool> telegram_running: false;
    in-out property <bool> telegram_busy: false;
    in-out property <string> telegram_error: "";
    in-out property <string> telegram_port: "1443";
    in-out property <string> telegram_secret: "";
    in-out property <string> telegram_dc_overrides: "2:149.154.167.220 4:149.154.167.220";
    in-out property <bool> telegram_fallback: true;
    in-out property <string> telegram_timeout: "5";
    in-out property <string> telegram_limit: "64";
    in-out property <string> telegram_link: "";
    changed show_telegram_proxy => {
        if (!root.show_telegram_proxy) {
            root.telegram_autostart = false;
            root.telegram_settings_open = false;
            if (root.current_page == "telegram") { root.current_page = "home"; }
        }
    }
    callback telegram_start();
    callback telegram_stop();
    callback telegram_save(string, string, string, bool, string, string);
    callback telegram_connect();
    callback set_telegram_visible(bool);
    callback set_telegram_autostart(bool);

    // ── Data ──
    in-out property <[StrategyItem]> strategies: [];
    // Full catalog size; search only changes the visible strategies model.
    in-out property <int> total_strategy_count: 0;
    in-out property <string> selected_strategy: "";
    in-out property <string> strategies_query: "";
    in-out property <[LogLineItem]> log_lines: [];
    in-out property <string> log_text: "";
    // Keep log controls and the backend filter aligned across page navigation.
    in-out property <string> logs_query: "";
    in-out property <string> logs_level: "ALL";
    in-out property <bool> logs_autoscroll: true;

    // ── Strategy tester ──
    in-out property <[TestResultItem]> test_results: [];
    in-out property <bool> test_running: false;
    in-out property <int> test_current: 0;
    in-out property <int> test_total: 0;
    in-out property <string> test_current_strategy: "";
    // Variant label (ALT / SIMPLE FAKE / …) of the strategy under test, or its
    // base name when it has no variant — computed by Rust (split_alt). Shown in
    // the sidebar status pill while a test run is in flight.
    in-out property <string> test_current_alt: "";
    in-out property <string> test_best_id: "";

    // Resolved strategy items for display. `selected_item` is set when the user
    // picks on the Strategies page; `active_item` is resolved by Rust from the
    // running strategy.
    in-out property <StrategyItem> selected_item;
    in-out property <StrategyItem> active_item;

    // ── Dashboard mode (simple one-button dial vs. full dashboard) ──
    in-out property <string> ui_mode: "simple";   // "simple" | "advanced"
    // The last simple-mode auto-engage run failed to find a working strategy
    // (distinct from a user cancel) — flips the dial to its red error state.
    in-out property <bool> simple_failed: false;
    // Progress of the in-flight auto-engage run ("trying 2 of 8"), shown under
    // the connecting dial. Reset when a run starts.
    in-out property <int> engage_index: 0;
    in-out property <int> engage_total: 0;

    // ── Settings (UI-local; persisted by Rust where wired) ──
    in-out property <bool> autostart: false;
    in-out property <bool> autoupdate_check: true;
    in-out property <bool> minimize_to_tray: false;
    in-out property <bool> autoengage: false;
    in-out property <bool> compact: false;
    in-out property <string> install_dir: "";
    in-out property <string> theme: "dark";
    // Actual system light/dark preference (detected by Rust). Used when theme is
    // "system" so that mode reflects the OS instead of always being dark.
    in-out property <bool> system_is_dark: true;

    // ── DPI bypass tuning (zapret service.bat filters; set from Rust) ──
    in-out property <string> game_filter: "off";   // off | all | tcp | udp
    in-out property <string> ipset_mode: "unknown"; // any | none | loaded | unknown
    in-out property <int> ipset_lines: 0;
    // Age of ipset-all.txt in days (-1 = absent/unknown); drives the stale reminder.
    in-out property <int> ipset_age_days: -1;
    in-out property <bool> ipset_busy: false;
    in-out property <string> ipset_msg: "";
    in-out property <bool> ipset_ok: true;
    in-out property <bool> hosts_busy: false;
    in-out property <string> hosts_msg: "";
    in-out property <bool> hosts_ok: true;
    in-out property <bool> discord_busy: false;
    in-out property <string> discord_msg: "";
    in-out property <bool> discord_ok: true;
    // Hosts review window (opened when the system hosts file is out of date).
    in-out property <bool> hosts_modal_open: false;
    in-out property <string> hosts_content: "";
    in-out property <string> hosts_path: "";
    in-out property <string> hosts_dir: "";

    // ── Aggregated status ──
    property <AppStatus> status: {
        installed: root.status_installed,
        installed_version: root.status_installed_version,
        latest_version: root.latest_version,
        update_available: root.has_update && root.latest_version != "" && root.status_installed_version != root.latest_version,
        running_mode: root.status_running_mode,
        active_strategy: root.status_active_strategy,
        winws_pid: root.status_winws_pid,
        service_installed: root.status_service_installed,
    };

    property <bool> running: root.status_running_mode != "None";
    property <StrategyItem> chosen_item: root.running && root.active_item.id != "" ? root.active_item : root.selected_item;
    property <bool> has_strategy: root.chosen_item.id != "";

    // ── Live bypass uptime ──
    // Owned by the window (not the page) so it survives page navigation. Seeded
    // from the OS-reported `status_uptime` on every poll, ticked locally each second.
    in-out property <int> uptime: 0;
    changed status_uptime => { root.uptime = root.status_uptime; }
    changed running => {
        if (!root.running) { root.uptime = 0; }
        // The bypass is up — clear any stale simple-mode error.
        if (root.running) { root.simple_failed = false; }
    }
    Timer {
        interval: 1s;
        running: root.running;
        triggered => { root.uptime += 1; }
    }

    // ── Callbacks to Rust ──
    callback start_clicked(string);
    callback stop_clicked();
    // Simple-mode dial: auto-pick a working strategy / cancel that run.
    callback auto_engage_clicked();
    callback cancel_engage_clicked();
    // Persist the dashboard mode ("simple" | "advanced").
    callback set_ui_mode(string);
    callback strategy_selected(string);
    callback install_clicked();
    callback check_update_clicked();
    callback update_clicked();
    // App self-update (zapret-ui itself).
    callback app_update_clicked();
    callback app_check_update_clicked();
    callback service_install_clicked(string);
    callback service_remove_clicked();
    callback service_start_clicked();
    callback service_stop_clicked();
    callback open_folder_clicked();
    callback open_ipset_file_clicked();
    callback open_hosts_file_clicked();
    callback refresh_status_clicked();
    callback strategies_search(string);
    callback test_start_clicked();
    callback test_cancel_clicked();
    callback test_use_strategy(string);
    callback toggle_favorite(string);
    callback logs_query_changed(string, string);
    callback logs_clear_clicked();
    callback open_log_file_clicked();
    callback open_url_clicked(string);
    callback set_language(string);
    callback set_game_filter(string);
    callback set_ipset_mode(string);
    callback update_ipset_clicked();
    callback update_hosts_clicked();
    callback clear_discord_cache_clicked();
    callback copy_to_clipboard(string);
    callback set_notifications(bool);
    callback set_autostart(bool);
    callback set_autoupdate_check(bool);
    callback set_minimize_to_tray(bool);
    callback set_autoengage(bool);
    callback set_theme(string);
    callback restart_as_admin();

    in-out property <string> current_page: "home";

    // "system" resolves to the real OS preference; "dark"/"light" are explicit.
    function resolve_dark() -> bool {
        return root.theme == "light" ? false : (root.theme == "dark" ? true : root.system_is_dark);
    }
    function apply-theme() {
        ThemePalette.is-dark = root.resolve_dark();
        // Standard TextEdit/scrollbar widgets otherwise keep the OS palette,
        // making log text unreadable when the app uses the opposite theme.
        Palette.color-scheme = ThemePalette.is-dark ? ColorScheme.dark : ColorScheme.light;
    }
    init => { root.apply-theme(); }
    changed theme => { root.apply-theme(); }
    changed system_is_dark => { root.apply-theme(); }

    HorizontalLayout {
        width: 100%;
        height: 100%;
        spacing: 0px;

        // ════════ SIDEBAR ════════
        Rectangle {
            width: 224px;
            background: ThemePalette.bg-2;
            Rectangle { x: parent.width - 1px; width: 1px; background: ThemePalette.border; }

            VerticalLayout {

                // brand
                HorizontalLayout {
                    vertical-stretch: 0;
                    padding-left: 18px;
                    padding-right: 18px;
                    padding-top: 24px;
                    padding-bottom: 30px;
                    spacing: 12px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 36px;
                            height: 36px;
                            border-radius: ThemePalette.r-10;
                            background: ThemePalette.accent;
                            BrandMark { size: 27px; tint: ThemePalette.accent-ink; }
                        }
                    }
                    VerticalLayout {
                        spacing: 4px;
                        alignment: center;
                        Text {
                            text: "zapret-ui";
                            font-family: ThemePalette.font-sans;
                            font-size: ThemePalette.fs-16;
                            font-weight: 700;
                            color: ThemePalette.text;
                        }
                        Text {
                            text: "DPI BYPASS";
                            font-family: ThemePalette.font-mono;
                            font-size: ThemePalette.fs-10;
                            color: ThemePalette.text-3;
                            letter-spacing: 1px;
                        }
                    }
                    Rectangle { }
                }

                // workspace section
                VerticalLayout {
                    vertical-stretch: 0;
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 5px;
                    Text {
                        text: I18n.t(I18n.lang, "nav.workspace");
                        font-family: ThemePalette.font-mono;
                        font-size: ThemePalette.fs-10;
                        color: ThemePalette.text-4;
                        letter-spacing: 1px;
                        // padding via a wrapper
                    }
                    Rectangle { height: 4px; }
                    NavItem {
                        label: I18n.t(I18n.lang, "nav.dashboard");
                        icon: @image-url("../assets/icons/home.svg");
                        active: root.current_page == "home";
                        clicked => { root.current_page = "home"; }
                    }
                    // Strategy selection + testing are advanced-only: in simple
                    // mode the dial auto-picks, so exposing a separate manual pick
                    // here just causes "selected one, ran another" confusion.
                    if root.ui_mode == "advanced" : NavItem {
                        label: I18n.t(I18n.lang, "nav.strategies");
                        icon: @image-url("../assets/icons/strategies.svg");
                        active: root.current_page == "strategies";
                        // Nudge a freshly-installed user (core present, nothing picked) here.
                        attention: root.status_installed && !root.has_strategy;
                        clicked => { root.current_page = "strategies"; }
                    }
                    if root.ui_mode == "advanced" : NavItem {
                        label: I18n.t(I18n.lang, "nav.tester");
                        icon: @image-url("../assets/icons/rocket.svg");
                        active: root.current_page == "tester";
                        clicked => { root.current_page = "tester"; }
                    }
                    NavItem {
                        label: I18n.t(I18n.lang, "nav.logs");
                        icon: @image-url("../assets/icons/logs.svg");
                        active: root.current_page == "logs";
                        clicked => { root.current_page = "logs"; }
                    }
                    NavItem {
                        label: I18n.t(I18n.lang, "nav.settings");
                        icon: @image-url("../assets/icons/settings.svg");
                        active: root.current_page == "settings";
                        clicked => { root.current_page = "settings"; }
                    }
                    NavItem {
                        label: I18n.t(I18n.lang, "nav.about");
                        icon: @image-url("../assets/icons/about.svg");
                        active: root.current_page == "about";
                        clicked => { root.current_page = "about"; }
                    }
                }

                Rectangle { vertical-stretch: 1; } // spacer pushes the footer to the bottom

                // footer
                VerticalLayout {
                    vertical-stretch: 0;
                    padding: 14px;
                    spacing: 10px;
                    Rectangle { height: 1px; background: ThemePalette.border; }
                    Rectangle { height: 4px; }

                    // Keep Telegram in the footer, just above the bypass status.
                    if root.show_telegram_proxy : NavItem {
                        label: I18n.t(I18n.lang, "telegram.title");
                        icon: @image-url("../assets/icons/telegram.svg");
                        branded: true;
                        accent: ThemePalette.is-dark ? #67bfe9 : #1377a8;
                        active: root.current_page == "telegram";
                        attention: root.telegram_running;
                        clicked => { root.current_page = "telegram"; }
                    }

                    // status pill (click → refresh)
                    Rectangle {
                        height: 44px;
                        border-radius: ThemePalette.r-8;
                        border-width: 1px;
                        border-color: ThemePalette.border;
                        background: pill-ta.has-hover ? ThemePalette.surface-hover : ThemePalette.surface;
                        clip: true;
                        animate background { duration: 120ms; }
                        pill-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                // While a test run is in flight the pill is a shortcut
                                // to the tester page; otherwise it goes to the dashboard.
                                root.current_page = root.test_running ? "tester" : "home";
                                root.refresh_status_clicked();
                            }
                        }
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 8px;
                            VerticalLayout {
                                alignment: center;
                                StatusDot {
                                    variant: root.test_running ? "testing"
                                        : root.running ? "active"
                                        : (root.status_installed ? "idle" : "danger");
                                }
                            }
                            Text {
                                horizontal-stretch: 0;
                                text: root.test_running ? I18n.t(I18n.lang, "sidebar.status_testing")
                                    : root.running
                                        ? (root.status_running_mode == "WindowsService" ? I18n.t(I18n.lang, "sidebar.status_service_running") : I18n.t(I18n.lang, "sidebar.status_bypass_active"))
                                        : (root.status_installed ? I18n.t(I18n.lang, "sidebar.status_idle") : I18n.t(I18n.lang, "sidebar.status_not_installed"));
                                font-family: ThemePalette.font-sans;
                                font-size: ThemePalette.fs-12;
                                font-weight: 500;
                                color: root.test_running ? ThemePalette.info-text : ThemePalette.text-2;
                                vertical-alignment: center;
                            }
                            // Variant chip — right-aligned, takes the slack and elides so long
                            // names (e.g. "FAKE TLS AUTO") stay inside the pill instead of
                            // spilling past its border.
                            Text {
                                horizontal-stretch: 1;
                                text: root.test_running ? root.test_current_alt
                                    : (root.running && root.active_item.id != "") ? (root.active_item.alt != "" ? root.active_item.alt : root.active_item.pretty)
                                    : "";
                                font-family: ThemePalette.font-mono;
                                font-size: ThemePalette.fs-10;
                                color: root.test_running ? ThemePalette.info : ThemePalette.text-3;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }

                    // theme toggle
                    Rectangle {
                        height: 38px;
                        border-radius: ThemePalette.r-8;
                        border-width: 1px;
                        border-color: ThemePalette.border;
                        background: ThemePalette.surface-2;
                        HorizontalLayout {
                            padding: 3px;
                            spacing: 3px;
                            // Order matches the Settings → Appearance segmented control.
                            ThemeToggleBtn {
                                icon: @image-url("../assets/icons/moon.svg");
                                active: root.theme == "dark";
                                clicked => { root.theme = "dark"; root.set_theme("dark"); }
                            }
                            ThemeToggleBtn {
                                icon: @image-url("../assets/icons/sun.svg");
                                active: root.theme == "light";
                                clicked => { root.theme = "light"; root.set_theme("light"); }
                            }
                            ThemeToggleBtn {
                                icon: @image-url("../assets/icons/system.svg");
                                active: root.theme == "system";
                                clicked => { root.theme = "system"; root.set_theme("system"); }
                            }
                        }
                    }

                }
            }
        }

        // ════════ CONTENT ════════
        Rectangle {
            background: ThemePalette.bg;
            clip: true;

            VerticalLayout {
                // Admin-rights warning bar (only when running unelevated).
                if !root.is_admin : AdminBanner {
                    restart_clicked => { root.restart_as_admin(); }
                }

                // App self-update bar on the dashboard (dismissible via the X).
                if root.current_page == "home" && root.app_has_update && !root.app_update_dismissed : UpdateBanner {
                    latest: root.app_latest_version;
                    downloading: root.app_update_downloading;
                    progress: root.app_update_progress;
                    update_clicked => { root.app_update_clicked(); }
                    dismiss_clicked => { root.app_update_dismissed = true; }
                }

                // page stack
                Rectangle {
                    vertical-stretch: 1;
                    clip: true;

            if root.current_page == "home" : Fade {
                VerticalLayout {
                    // mode toggle — centred above the dashboard in both sub-modes
                    HorizontalLayout {
                        vertical-stretch: 0;
                        alignment: center;
                        padding-top: 24px;
                        padding-bottom: 12px;
                        ModeToggle {
                            mode: root.ui_mode;
                            simple-label: I18n.t(I18n.lang, "mode.simple");
                            advanced-label: I18n.t(I18n.lang, "mode.advanced");
                            changed(m) => {
                                root.ui_mode = m;
                                root.set_ui_mode(m);
                                // Strategies/Tester are hidden in simple mode — if
                                // somehow parked there, fall back to the dashboard.
                                if (m == "simple" && (root.current_page == "strategies" || root.current_page == "tester")) {
                                    root.current_page = "home";
                                }
                            }
                        }
                    }

                    // ── simple mode: the one-button power dial ──
                    if root.ui_mode == "simple" : ModeFade {
                        vertical-stretch: 1;
                        SimpleModePage {
                        width: 100%;
                        height: 100%;
                        status: root.status;
                        chosen_item: root.chosen_item;
                        is_admin: root.is_admin;
                        is_busy: root.is_busy;
                        pending_op: root.pending_op;
                        simple_failed: root.simple_failed;
                        engage_index: root.engage_index;
                        engage_total: root.engage_total;
                        uptime: root.uptime;
                        update_checking: root.app_update_checking;
                        update_checked: root.app_update_checked;
                        update_available: root.has_update || root.app_has_update;
                        // Kick off auto-pick: lock the UI + mark the connecting
                        // transition the instant it's clicked.
                        engage_clicked => {
                            root.simple_failed = false;
                            root.engage_index = 0;
                            root.engage_total = 0;
                            root.pending_op = "start";
                            root.is_busy = true;
                            root.auto_engage_clicked();
                        }
                        stop_clicked => { root.pending_op = "stop"; root.is_busy = true; root.stop_clicked(); }
                        cancel_clicked => { root.cancel_engage_clicked(); }
                        install_clicked => { root.is_busy = true; root.install_clicked(); }
                        restart_admin => { root.restart_as_admin(); }
                        // Check both the zapret core and zapret-ui itself, so the
                        // footer status covers either having an update.
                        check_update_clicked => { root.check_update_clicked(); root.app_check_update_clicked(); }
                        open_advanced => { root.ui_mode = "advanced"; root.set_ui_mode("advanced"); }
                        }
                    }

                    // ── advanced mode: the full dashboard ──
                    if root.ui_mode == "advanced" : ModeFade {
                        vertical-stretch: 1;
                        HomePage {
                        width: 100%;
                        height: 100%;
                        status: root.status;
                    chosen_item: root.chosen_item;
                    has_strategy: root.has_strategy;
                    is_busy: root.is_busy;
                    pending_op: root.pending_op;
                    is_admin: root.is_admin;
                    strategy_count: root.total_strategy_count;
                    app_version: root.app_version;
                    uptime: root.uptime;
                    game_filter <=> root.game_filter;
                    ipset_mode <=> root.ipset_mode;
                    ipset_lines: root.ipset_lines;
                    ipset_age_days: root.ipset_age_days;
                    ipset_busy: root.ipset_busy;
                    ipset_msg: root.ipset_msg;
                    ipset_ok: root.ipset_ok;
                    game_filter_changed(v) => { root.set_game_filter(v); }
                    ipset_mode_changed(v) => { root.set_ipset_mode(v); }
                    update_ipset_clicked => { root.update_ipset_clicked(); }
                    // Mark the transition + lock the UI the instant it's clicked; the
                    // backend round-trip (and the spinner) ends when Status arrives.
                    start_clicked => { root.pending_op = "start"; root.is_busy = true; root.start_clicked(root.chosen_item.id); }
                    stop_clicked => { root.pending_op = "stop"; root.is_busy = true; root.stop_clicked(); }
                    install_clicked => { root.install_clicked(); }
                    check_update_clicked => { root.check_update_clicked(); }
                    update_clicked => { root.update_clicked(); }
                    open_folder_clicked => { root.open_folder_clicked(); }
                    pick_strategy_clicked => { root.current_page = "strategies"; }
                    refresh_clicked => { root.refresh_status_clicked(); }
                    service_install_clicked => { root.pending_op = "start"; root.is_busy = true; root.service_install_clicked(root.chosen_item.id); }
                    service_start_clicked => { root.pending_op = "start"; root.is_busy = true; root.service_start_clicked(); }
                    service_stop_clicked => { root.pending_op = "stop"; root.is_busy = true; root.service_stop_clicked(); }
                    service_remove_clicked => { root.pending_op = "stop"; root.is_busy = true; root.service_remove_clicked(); }
                    }
                    }
                }
            }

            if root.current_page == "strategies" : Fade {
                StrategiesPage {
                    width: 100%;
                    height: 100%;
                    strategies_model: root.strategies;
                    active_strategy_id: root.status_active_strategy;
                    selected_strategy: root.selected_item.id;
                    is_busy: root.is_busy;
                    query <=> root.strategies_query;
                    search_changed(q) => { root.strategies_search(q); }
                    picked(item) => {
                        root.selected_item = item;
                        root.selected_strategy = item.id;
                        root.strategy_selected(item.id);
                        root.current_page = "home";
                    }
                    toggle_favorite(id) => { root.toggle_favorite(id); }
                }
            }

            if root.current_page == "tester" : Fade {
                TesterPage {
                    width: 100%;
                    height: 100%;
                    results: root.test_results;
                    is_admin: root.is_admin;
                    running: root.test_running;
                    current: root.test_current;
                    total: root.test_total;
                    current_strategy: root.test_current_strategy;
                    best_id: root.test_best_id;
                    selected_strategy: root.selected_item.id;
                    installed: root.status_installed;
                    strategy_count: root.total_strategy_count;
                    start_clicked => { root.test_start_clicked(); }
                    cancel_clicked => { root.test_cancel_clicked(); }
                    use_strategy(id) => { root.test_use_strategy(id); }
                    toggle_favorite(id) => { root.toggle_favorite(id); }
                }
            }

            if root.current_page == "telegram" && root.show_telegram_proxy : Fade {
                TelegramPage {
                    settings-open <=> root.telegram_settings_open;
                    running: root.telegram_running;
                    busy: root.telegram_busy;
                    error: root.telegram_error;
                    port: root.telegram_port;
                    secret: root.telegram_secret;
                    dc-overrides: root.telegram_dc_overrides;
                    fallback: root.telegram_fallback;
                    timeout: root.telegram_timeout;
                    limit: root.telegram_limit;
                    link: root.telegram_link;
                    start-clicked => { root.telegram_busy = true; root.telegram_error = ""; root.telegram_start(); }
                    stop-clicked => { root.telegram_busy = true; root.telegram_error = ""; root.telegram_stop(); }
                    connect-clicked => { root.telegram_connect(); }
                    copy-clicked => { root.copy_to_clipboard(root.telegram_link); }
                    save-clicked(p, s, d, f, t, l) => {
                        root.telegram_busy = true;
                        root.telegram_error = "";
                        root.telegram_save(p, s, d, f, t, l);
                    }
                }
            }

            if root.current_page == "settings" : Fade {
                SettingsPage {
                    width: 100%;
                    height: 100%;
                    autostart <=> root.autostart;
                    autoupdate_check <=> root.autoupdate_check;
                    minimize_to_tray <=> root.minimize_to_tray;
                    notifications <=> root.notifications;
                    show_telegram_proxy <=> root.show_telegram_proxy;
                    telegram_autostart <=> root.telegram_autostart;
                    telegram_visibility_changed(v) => { root.set_telegram_visible(v); }
                    telegram_autostart_changed(v) => { root.set_telegram_autostart(v); }
                    autoengage <=> root.autoengage;
                    compact <=> root.compact;
                    install_dir <=> root.install_dir;
                    theme <=> root.theme;
                    app_version: root.app_version;
                    app_has_update: root.app_has_update;
                    app_latest_version: root.app_latest_version;
                    app_update_checking: root.app_update_checking;
                    app_update_downloading: root.app_update_downloading;
                    app_update_progress: root.app_update_progress;
                    app_update_checked: root.app_update_checked;
                    app_update_ok: root.app_update_ok;
                    app_update_msg: root.app_update_msg;
                    app_check_update_clicked => { root.app_check_update_clicked(); }
                    app_update_clicked => { root.app_update_clicked(); }
                    installed: root.status_installed;
                    game_filter <=> root.game_filter;
                    ipset_mode <=> root.ipset_mode;
                    ipset_lines: root.ipset_lines;
                    ipset_busy: root.ipset_busy;
                    ipset_msg: root.ipset_msg;
                    ipset_ok: root.ipset_ok;
                    hosts_busy: root.hosts_busy;
                    hosts_msg: root.hosts_msg;
                    hosts_ok: root.hosts_ok;
                    discord_busy: root.discord_busy;
                    discord_msg: root.discord_msg;
                    discord_ok: root.discord_ok;
                    open_folder_clicked => { root.open_folder_clicked(); }
                    open_ipset_file_clicked => { root.open_ipset_file_clicked(); }
                    open_hosts_file_clicked => { root.open_hosts_file_clicked(); }
                    game_filter_changed(v) => { root.set_game_filter(v); }
                    ipset_mode_changed(v) => { root.set_ipset_mode(v); }
                    update_ipset_clicked => { root.update_ipset_clicked(); }
                    update_hosts_clicked => { root.update_hosts_clicked(); }
                    clear_discord_cache_clicked => { root.clear_discord_cache_clicked(); }
                    language_changed(v) => { root.set_language(v); }
                    notifications_changed(v) => { root.set_notifications(v); }
                    autostart_changed(v) => { root.set_autostart(v); }
                    autoupdate_changed(v) => { root.set_autoupdate_check(v); }
                    tray_changed(v) => { root.set_minimize_to_tray(v); }
                    autoengage_changed(v) => { root.set_autoengage(v); }
                    theme_changed(v) => { root.set_theme(v); }
                }
            }

            if root.current_page == "logs" : Fade {
                LogsPage {
                    width: 100%;
                    height: 100%;
                    log_lines: root.log_lines;
                    log_text: root.log_text;
                    query <=> root.logs_query;
                    level <=> root.logs_level;
                    autoscroll <=> root.logs_autoscroll;
                    open_file_clicked => { root.open_log_file_clicked(); }
                    clear_clicked => { root.logs_clear_clicked(); }
                    query_changed(g, l) => { root.logs_query_changed(g, l); }
                }
            }

            if root.current_page == "about" : Fade {
                AboutPage {
                    width: 100%;
                    height: 100%;
                    status: root.status;
                    app_version: root.app_version;
                    repo_url: root.repo_url;
                    app_has_update: root.app_has_update;
                    app_latest_version: root.app_latest_version;
                    app_update_downloading: root.app_update_downloading;
                    open_url(u) => { root.open_url_clicked(u); }
                    app_update_clicked => { root.app_update_clicked(); }
                }
            }
                }
            }
        }
    }

    // ── Hosts review modal (overlays everything when open) ──
    if root.hosts_modal_open : HostsDialog {
        open: root.hosts_modal_open;
        content: root.hosts_content;
        hosts_path: root.hosts_path;
        copy_clicked => { root.copy_to_clipboard(root.hosts_content); }
        open_folder_clicked => { root.open_url_clicked(root.hosts_dir); }
        close_clicked => { root.hosts_modal_open = false; }
    }
}
